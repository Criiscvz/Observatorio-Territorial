        "/dashboard/{departamento}/bivariable": {
            "post": {
                "tags": [
                    "Dashboard"
                ],
                "summary": "Análisis bivariable",
                "description": "Obtiene análisis de correlación entre dos variables",
                "operationId": "13bdb85b913caa94ab941fef6d0bc80d",
                "parameters": [
                    {
                        "name": "departamento",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "dataset_id",
                                    "variable_x",
                                    "variable_y"
