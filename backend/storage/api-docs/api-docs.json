        "/dashboard/{departamento}/stats": {
            "get": {
                "tags": [
                    "Dashboard"
                ],
                "summary": "Estadísticas del dashboard",
                "description": "Obtiene estadísticas específicas para gráficos",
                "operationId": "8d2ee2384609c69da6d51b47271286a2",
