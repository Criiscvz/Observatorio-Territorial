APP_NAME="Observatorio ULEAM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-service.onrender.com
FRONTEND_URL=https://your-vercel-project.vercel.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL (Neon). Use DATABASE_URL or the individual DB_* variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# MongoDB Configuration
MONGODB_URI=
MONGODB_DATABASE=observatorio_nosql

# Swagger Configuration
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=https://your-render-service.onrender.com/api

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_ROOT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ============================================
# SEED CONFIGURATION (Required for /api/seed endpoints)
# ============================================
# Token de seguridad para ejecutar seeders via API
# IMPORTANTE: Cambia este valor por uno seguro y único
SEED_TOKEN=

# Credenciales del usuario administrador inicial
# IMPORTANTE: Usa una contraseña segura en producción
ADMIN_NAME=Initial Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Credenciales del usuario normal inicial
INITIAL_USER_NAME=Initial User
INITIAL_USER_EMAIL=user@example.com
INITIAL_USER_PASSWORD=change-this-user-password

# Credenciales del usuario suscriptor inicial
SUBSCRIBER_NAME=Initial Subscriber
SUBSCRIBER_EMAIL=subscriber@example.com
SUBSCRIBER_PASSWORD=change-this-subscriber-password

# ============================================
# MICROSOFT SHAREPOINT / GRAPH CONFIGURATION
# ============================================
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_PATH=
SHAREPOINT_BAROMETER_FOLDER_PATH=
