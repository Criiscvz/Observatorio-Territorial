# Merge these values into your ignored backend/.env only for local HTTP testing.
# Keep your existing database, MongoDB, APP_KEY, and initial-user values unchanged.

APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

SANCTUM_STATEFUL_DOMAINS=localhost:4200
SESSION_DRIVER=file
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
