{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:vercel": "node scripts/set-api-url.mjs && ng build --configuration production && node scripts/create-vercel-spa-entry.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:security-headers": "node --test scripts/security-headers.test.mjs",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@angular/ssr": "21.2.27",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "echarts": "^5.6.0",
    "echarts-wordcloud": "^2.1.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "install": "^0.13.0",
    "ngx-echarts": "^21.0.0",
    "pdfjs-dist": "6.4.299",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "4.1.11"
  }
}
